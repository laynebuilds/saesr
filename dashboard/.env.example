# 1 = scripted mock data, no backend needed. 0 = Layne's backend + actors + relay.
VITE_MOCK=1
# Python FastAPI backend (events, agents feed, /site, /video, /clips)
VITE_BACKEND_URL=http://localhost:8000
# Supabase, history only. Anon key only, never the secret key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Durable actors observer UI, linked from the health drawer
VITE_ACTORS_OBSERVER_URL=http://127.0.0.1:7100

# Server-side only (upload analysis). Never prefix with VITE_.
ANTHROPIC_API_KEY=

# Only if the backend sets INTERNAL_TOKEN / ADMIN_TOKEN
VITE_INTERNAL_TOKEN=
VITE_ADMIN_TOKEN=
